PORT=3000
DEBUG=false
# 本地开发模式：设置为 debug 时，Gin 框架进入调试模式，前端可以跨域携带 cookie 请求非 /v1/* 路由
# 提醒：生产环境**不要**设置此变量（保持不设 = 生产模式 = 安全默认）
GIN_MODE=debug
HTTPS_PROXY=http://localhost:7890

# ========== 异步任务系统 (Phase A-I) ==========
# 总开关：开启后 worker 启动、/v1/tasks/* 路由注册、ApiMart/Jimeng 类型 channel 走异步路径。
# off 时与现有同步行为字节级等价。
ENABLE_TASK_SYSTEM=false

# Worker 拉取间隔（每隔多久查一次 pending 任务的上游状态）
TASK_WORKER_INTERVAL=5s

# 单轮 tick 处理任务数上限
TASK_WORKER_BATCH_SIZE=50

# 任务超过 N 分钟未完成 → 自动 TIMEOUT + 退款
TASK_TIMEOUT_MINUTES=10

# 完成/失败/超时任务保留天数（凌晨 3 点扫描清理）
TASK_RETENTION_DAYS=30

# 单次上游 HTTP 请求超时
TASK_UPSTREAM_HTTP_TIMEOUT=30s

# 同一任务连续 fetch 失败多少次后强制 FAILURE + 退款
TASK_MAX_FETCH_ERRORS=5